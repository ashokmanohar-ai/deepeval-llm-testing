# Azure OpenAI credentials. Copy this file to .env and replace placeholders.
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Optional: the underlying model family can differ from the Azure deployment name.
# If omitted, the application uses AZURE_OPENAI_DEPLOYMENT_NAME.
AZURE_OPENAI_MODEL_NAME=gpt-4.1

# Optional generation settings.
AZURE_OPENAI_TEMPERATURE=0

# Privacy: disable DeepEval's anonymous PostHog telemetry for local and CI runs.
DEEPEVAL_TELEMETRY_OPT_OUT=1
